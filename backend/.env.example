# Copy to backend/.env and adjust. Every setting is a CXS_* variable; see
# src/catenax_simplified/config.py and backend/README.md. Lists and objects are JSON.

# Your company's BPNL (required).
CXS_OWN_BPNL=BPNL000000000T1A

# SQLAlchemy URL. Postgres needs the extra: uv sync --extra postgres
CXS_DATABASE_URL=sqlite:///./catenax-simplified.db
# CXS_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/traceability

# Own Digital Twin Registry (AAS API v3). The values below point to the mock participant
# (uv run python devtools/mock_participant.py --port 8081).
CXS_DTR_BASE_URL=http://localhost:8081
# CXS_DTR_LOOKUP_URL=            # defaults to CXS_DTR_BASE_URL
CXS_DTR_API_PATH=/api/v3
CXS_DTR_PAGE_SIZE=100

# Keycloak client credentials for the DTR (leave unset if the DTR needs no token).
# CXS_OAUTH_URL=https://keycloak.example.com/auth/
# CXS_OAUTH_REALM=CX-Central
# CXS_OAUTH_CLIENT_ID=traceability
# CXS_OAUTH_CLIENT_SECRET=change-me
# Any other OAuth 2.0 token endpoint instead of a Keycloak realm (wins over URL/REALM):
# CXS_OAUTH_TOKEN_URL=https://login.example.com/tenant/oauth2/v2.0/token
# CXS_OAUTH_SCOPE=api://dtr/.default

# Read own submodels from the internal backend instead of the public EDC data plane:
# a JSON list of [public prefix, internal prefix] pairs; the first matching prefix wins.
CXS_SUBMODEL_HREF_REWRITES=[]
# CXS_SUBMODEL_HREF_REWRITES=[["https://edc.example.com/api/public", "http://submodel-server:8080/data"]]

# Extra headers for the submodel backend, as a JSON object.
CXS_SUBMODEL_HEADERS={}
# CXS_SUBMODEL_HEADERS={"X-Api-Key": "change-me"}

# --- Direct partners (phase 2) -------------------------------------------------------------
# Own Tractus-X EDC (0.12, Saturn) management API; leave unset to disable partner sync.
# CXS_EDC_MANAGEMENT_URL=https://edc-control-plane.example.com
# CXS_EDC_MANAGEMENT_PATH=/management
# CXS_EDC_API_KEY=change-me
# Or/also OAuth 2.0 client credentials for the management API:
# CXS_EDC_OAUTH_TOKEN_URL=https://login.example.com/tenant/oauth2/v2.0/token
# CXS_EDC_OAUTH_CLIENT_ID=traceability
# CXS_EDC_OAUTH_CLIENT_SECRET=change-me
# CXS_EDC_OAUTH_SCOPE=api://edc/.default

# Usage policies you accept in partners' catalogs: a JSON list of ODRL policy bodies without
# @id/@type, compared with each offer. Empty = no negotiation happens.
CXS_ACCEPTED_POLICIES=[]
# CXS_ACCEPTED_POLICIES=[{"odrl:permission": {"odrl:action": {"@id": "odrl:use"}, "odrl:constraint": {"odrl:and": [...]}}}]
# Accept any offered policy. Development only — never in production.
CXS_ACCEPT_ANY_POLICY=false

# Partners' DSP endpoints by BPNL (JSON object). Addresses set through PUT /api/partners/{bpnl}
# take precedence.
CXS_PARTNER_CONNECTORS={}
# CXS_PARTNER_CONNECTORS={"BPNL000000000T2A": "https://edc.tier2.example.com/api/v1/dsp"}

# --- Core services of the dataspace (Setup page) ---------------------------------------------
# Technical user of the central IdP; independent of the DTR's CXS_OAUTH_* client.
# CXS_CENTRAL_IDP_URL=https://centralidp.example.com/auth/
# CXS_CENTRAL_IDP_REALM=CX-Central
# CXS_CENTRAL_IDP_CLIENT_ID=sa-traceability
# CXS_CENTRAL_IDP_CLIENT_SECRET=change-me
# Discovery Finder: finds partners' DSP endpoints by BPNL.
# CXS_DISCOVERY_FINDER_URL=https://discoveryfinder.example.com/api/v1.0/administration/connectors/discovery/search
# BPDM Pool, up to the version segment: partners' legal names by BPNL.
# CXS_BPDM_POOL_URL=https://business-partners.example.com/pool/api

# --- Quality notifications (phase 2) -------------------------------------------------------
# Where our EDC's data plane reaches this app. With an EDC configured, the notification assets
# (receive/update x alert/investigation x API 1.2.1/2.0.0) are published at startup.
# CXS_NOTIFICATION_BASE_URL=http://catenax-simplified:8000
# Required as X-Api-Key on /api/qualitynotifications/*; also set in the assets' data address.
# CXS_NOTIFICATION_API_KEY=change-me
# ODRL permissions of the assets' policies (JSON); empty = KIT defaults (active membership;
# DataExchangeGovernance:1.0 + cx.core.qualityNotifications:1).
CXS_NOTIFICATION_ACCESS_POLICY=[]
CXS_NOTIFICATION_USAGE_POLICY=[]
# CXS_NOTIFICATION_ACCESS_POLICY=[{"action": "access", "constraint": {"and": [{"leftOperand": "BusinessPartnerNumber", "operator": "isAnyOf", "rightOperand": ["BPNL000000000T2A", "BPNL000000000OEM"]}]}}]
# CXS_NOTIFICATION_ASSET_PREFIX=cxs-qualitynotification

# --- Development only ------------------------------------------------------------------------
# Reach partners without EDCs (local multi-company demos, see devtools/demo_network.py):
# notifications go to the partner apps (CXS_PARTNER_CONNECTORS = their base URLs) and partner
# twins are read from their registries. Never in a dataspace.
CXS_DEV_DIRECT=false
# CXS_DEV_PARTNER_DTRS={"BPNL000000000T2A": "http://127.0.0.1:8102/api/v3"}

# Periodic sync in seconds — own twins, then partners when an EDC is configured; 0 = manual only
# (POST /api/sync, POST /api/partners/sync).
CXS_SYNC_INTERVAL_SECONDS=0

# Serve the built UI (npm run build in ../web) at "/".
# CXS_WEB_DIST_DIR=../web/dist
